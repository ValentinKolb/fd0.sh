{
  "manifest_version": 3,
  "name": "fd0 Development",
  "version": "0.1.0",
  "description": "Fill fd0 logins from HTTPS sign-in forms.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Fill login with fd0"
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}
