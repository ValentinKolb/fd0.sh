{
  "name": "fd0-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "fd0 desktop password manager",
  "author": "Valentin Kolb",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "bun run scripts/dev.ts",
    "dev:reset": "bun run scripts/reset-dev.ts",
    "build": "bun run scripts/build.ts",
    "build:ui": "electron-vite build",
    "package": "bun run scripts/package.ts",
    "dist": "bun run build && electron-builder",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun run build && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.2.9",
    "@fontsource-variable/geist-mono": "5.2.8",
    "@tabler/icons-solidjs": "3.44.0",
    "@valentinkolb/stdlib": "0.13.0",
    "electron-updater": "6.8.9",
    "solid-js": "1.9.14"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "@playwright/test": "1.61.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vite-plugin-solid": "2.11.12"
  },
  "trustedDependencies": [
    "electron"
  ],
  "build": {
    "appId": "sh.fd0.desktop",
    "productName": "fd0",
    "artifactName": "fd0-desktop_${version}_${os}_${arch}.${ext}",
    "icon": "resources/icon.png",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "out/**/*",
      "resources/icon.png",
      "resources/tray.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../.build/desktop/fd0-desktop-bridge",
        "to": "bin/fd0-desktop-bridge"
      },
      {
        "from": "../.build/desktop/fd0-agent",
        "to": "bin/fd0-agent"
      },
      {
        "from": "../.build/desktop/fd0",
        "to": "bin/fd0"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "extraFiles": [
        {
          "from": "resources/sh.fd0.desktop.agent.plist",
          "to": "Library/LaunchAgents/sh.fd0.desktop.agent.plist"
        }
      ],
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Utility",
      "maintainer": "Valentin Kolb",
      "synopsis": "fd0 password and infrastructure credential manager",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "deb": {
      "depends": ["libpcsclite1"]
    },
    "rpm": {
      "depends": ["pcsc-lite-libs"]
    },
    "publish": [{
      "provider": "github",
      "owner": "ValentinKolb",
      "repo": "fd0.sh",
      "releaseType": "release"
    }]
  }
}
