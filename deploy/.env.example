# fd0 deployment — environment.
#
#   cp .env.example .env  &&  edit
#
# `docker compose` reads this file automatically when it sits next to
# compose.yml. Variables propagate to the labelled services below.

# ─── Domain ───────────────────────────────────────────────────────────
# Apex of your deployment. The compose file derives subdomains from it:
#   ${DOMAIN}          → website
#   api.${DOMAIN}      → server
#   witness.${DOMAIN}  → witness
DOMAIN=fd0.sh

# Address shown to Let's Encrypt for cert expiry warnings.
ACME_EMAIL=admin@example.com

# ─── Image source ─────────────────────────────────────────────────────
# ghcr.io/${GHCR_OWNER}/fd0-{server,witness,website}:${FD0_VERSION}
GHCR_OWNER=valentinkolb

# Pin in production. `latest` is convenient for trying it out, risky
# under autoscale — a re-pull mid-rollout will mix versions.
FD0_VERSION=latest

# ─── Shared metrics token ─────────────────────────────────────────────
# One bearer token for /metrics on all three services. A single
# Prometheus scrape job can then carry one bearer_token across all
# three jobs. Anything other than this exact string gets a 404 (we
# don't leak the endpoint's existence).
#
# Generate:   openssl rand -hex 32
METRICS_TOKEN=replace-with-openssl-rand-hex-32
